{
	"$schema": "node_modules/wrangler/config-schema.json",
	// the product is Cordeau; the Worker, database and bucket keep the names they were created with
	// (renaming the Worker would change its workers.dev URL and the Google OAuth redirect URI)
	"name": "snapline",
	"main": "worker/index.ts",
	"compatibility_date": "2026-09-01",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"/auth/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "snapline",
			"database_id": "84b05d25-936a-4946-8008-c6dbeb2bb55c",
			"migrations_dir": "worker/migrations",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "MODELS",
			"bucket_name": "snapline-models"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "ROOM",
				"class_name": "ProjectRoom"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["ProjectRoom"]
		}
	],
	"ratelimits": [
		{
			"name": "API_LIMIT",
			"namespace_id": "1001",
			"simple": { "limit": 300, "period": 60 }
		},
		{
			"name": "STRICT_LIMIT",
			"namespace_id": "1002",
			"simple": { "limit": 30, "period": 60 }
		}
	],
	"observability": {
		"enabled": true
	}
}
