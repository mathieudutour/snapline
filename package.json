{
  "name": "snapline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Constraint-based floor plan editor with 3D and first-person walkthrough",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "dev:worker": "wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 execute snapline --remote --file worker/schema.sql",
    "db:migrate:local": "wrangler d1 execute snapline --local --file worker/schema.sql"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "jspdf": "^2.5.2",
    "pdfjs-dist": "^4.10.38",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "three": "^0.186.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260914.1",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.4.0",
    "meshoptimizer": "^1.2.0",
    "obj2gltf": "^3.2.0",
    "sharp": "^0.35.4",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0",
    "wrangler": "^4.131.2"
  }
}
